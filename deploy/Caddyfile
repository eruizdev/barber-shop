# Caddy: pone HTTPS (certificado gratis y automático) y reenvía todo a la app.
# {$DOMAIN} sale del archivo .env (ej. sebas-barber.com). El tráfico HTTP (puerto 80) se redirige solo a HTTPS.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000
}

# www.sebas-barber.com -> sebas-barber.com
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
