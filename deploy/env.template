# ===== Sebas Barber — configuración del servidor (VPS) =====
# install.sh copia este archivo a ".env" y rellena las claves con valores al azar.
# Si lo editas a mano: no uses el signo $ en las contraseñas.

# Tu dominio (ya apuntando a la IP del servidor). Ej: sebasbarber.com
DOMAIN=__DOMAIN__

# Base de datos (Postgres, dentro de Docker)
DB_PASSWORD=__DB_PASSWORD__

# Firma de la sesión del admin
SESSION_SECRET=__SESSION_SECRET__

# Administradores del panel /admin (hasta 5: ADMIN3_USER, ADMIN3_PASS, ...)
ADMIN1_USER=sebasraigoza
ADMIN1_PASS=__ADMIN1_PASS__
ADMIN2_USER=ruiz
ADMIN2_PASS=__ADMIN2_PASS__

# WhatsApp del negocio (solo dígitos, con 57): sale como botón de contacto en la web
BUSINESS_WHATSAPP=__BUSINESS_WHATSAPP__
BUSINESS_NAME=Sebas Barber

# WAHA (envía los mensajes desde tu WhatsApp Business)
WAHA_API_KEY=__WAHA_API_KEY__
WAHA_DASHBOARD_USER=admin
WAHA_DASHBOARD_PASSWORD=__WAHA_DASHBOARD_PASSWORD__
# Minutos antes de la cita en que se manda el recordatorio
REMINDER_MINUTES_BEFORE=60

# Agenda: lunes desde el que se cuentan los bloques de 2 semanas, y hora del domingo en que se abre el siguiente
BOOKING_ANCHOR=2026-11-02
BOOKING_OPEN_TIME=08:00
MIN_LEAD_MINUTES=60
MAX_ACTIVE_PER_PHONE=2
HISTORY_DAYS=3
